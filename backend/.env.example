# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/chat-app

# Port for the Express/Socket.io server
PORT=5000

# Secret used to sign JWT auth tokens - use a long random string in production
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# 32-byte (64 hex char) key used for AES-256-GCM message encryption at rest.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MESSAGE_ENCRYPTION_KEY=replace_this_with_a_64_char_hex_string

# Comma-separated list of allowed frontend origins for CORS
CLIENT_ORIGIN=http://localhost:5173
